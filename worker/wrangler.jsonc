{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "done-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",

  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },

  "workers_dev": true,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "AI_USAGE_DB",
      "database_name": "done-ai-usage",
      "database_id": "bf960a4c-e0cf-4f5e-b496-acd5dec856cc"
    }
  ],

  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "GEMINI_MODEL",
      "AI_PROJECT_DAILY_LIMIT",
      "FIREBASE_PROJECT_ID",
      "FIREBASE_STORAGE_BUCKET",
      "FIREBASE_PROJECT_NUMBER",
      "FIREBASE_ANDROID_APP_ID",
      "FIREBASE_IOS_APP_ID"
    ]
  }
}
