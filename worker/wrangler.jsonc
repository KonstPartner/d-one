{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "done-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "FIREBASE_PROJECT_ID": "project-d-one",
    "FIREBASE_STORAGE_BUCKET": "project-d-one.firebasestorage.app"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}
