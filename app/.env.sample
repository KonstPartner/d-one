# Public web app URL
EXPO_PUBLIC_APP_URL="Public HTTPS URL of the web app used to generate shareable links"

# Android App Links host
APP_LINK_HOST="Host only, without protocol/path, used for Android App Links verification and intent filters"

# Base API configuration
EXPO_PUBLIC_AI_API_URL="Base URL for AI API requests without trailing slash"

# Expo EAS project ID
EXPO_PUBLIC_EAS_PROJECT_ID="Expo EAS project ID used for project linking and EAS services"

# Google OAuth client IDs for different platforms
WEB_GOOGLE_CLIENT_ID="OAuth 2.0 Web Client ID"
ANDROID_GOOGLE_CLIENT_ID="OAuth 2.0 Android Client ID"
IOS_GOOGLE_CLIENT_ID="OAuth 2.0 iOS Client ID"

# Firebase Web SDK API key
EXPO_PUBLIC_FIREBASE_API_KEY="Firebase Web API key from Firebase project settings"

# Firebase Auth domain
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="Firebase Auth domain, usually <project-id>.firebaseapp.com"

# Firebase project ID
EXPO_PUBLIC_FIREBASE_PROJECT_ID="Firebase project ID"

# Firebase Storage bucket
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="Firebase Storage bucket name"

# Firebase project number / messaging sender ID
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="Firebase project number used as Messaging Sender ID"

# Firebase Web app ID
EXPO_PUBLIC_FIREBASE_APP_ID="Firebase Web application ID"

# Firebase Analytics measurement ID
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID="Firebase Analytics measurement ID"

# Native Firebase configuration files
GOOGLE_SERVICES_JSON="Path to Android google-services.json"
GOOGLE_SERVICE_INFO_PLIST="Path to iOS GoogleService-Info.plist"

# Firebase Android app check
ANDROID_APP_CHECK_DEBUG_TOKEN="Firebase app check debug token"