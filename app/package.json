{
  "name": "d-one",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "prebuild": "npx expo prebuild --clean",
    "android": "expo run:android",
    "build-android-dev": "bash -c 'mkdir -p builds; DATE=$(date +%H-%M_%d-%m-%y); ./scripts/android-allow-applinks.sh && eas build --profile development --platform android --local --output \"./builds/d-one_dev_$DATE.apk\"; STATUS=$?; ./scripts/android-reset-applinks.sh; exit $STATUS'",
    "build-android-preview": "bash -c 'mkdir -p builds; DATE=$(date +%H-%M_%d-%m-%y); ./scripts/android-allow-applinks.sh && eas build --profile preview --platform android --local --output \"./builds/d-one_pre_$DATE.apk\"; STATUS=$?; ./scripts/android-reset-applinks.sh; exit $STATUS'",
    "prebuild-android": "npx expo prebuild -p android",
    "ios": "expo run:ios",
    "build-ios": "npx expo run:ios --device",
    "prebuild-ios": "npx expo prebuild -p ios",
    "web": "expo start --web",
    "deploy-web": "rm -rf dist && expo export --platform web && eas deploy --prod",
    "test": "jest --watchAll",
    "test-check": "jest --ci --bail --runInBand --passWithNoTests",
    "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "lint:types": "npx tsc --noEmit",
    "lint": "eslint ./src/ --ext .js,.jsx,.ts,.tsx",
    "lint-fix:imports": "npm run lint -- --fix -c ./.eslint/extenders/.eslintrc.imports.json",
    "lint-fix": "npm run lint-fix:imports",
    "lint:errors": "npm run lint -- --quiet -c ./.eslint/extenders/.eslintrc.all.json",
    "lint:unused": "knip",
    "lint:arch": "npx steiger ./src",
    "prepare": "cd .. && husky install .husky"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@emotion/native": "^11.11.0",
    "@emotion/react": "^11.13.5",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "dotenv": "^16.4.7",
    "expo": "~54.0.32",
    "expo-auth-session": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.22",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "firebase": "12.2.1",
    "i18next": "^25.7.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^16.5.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-popover-view": "^6.1.0",
    "react-native-portalize": "^1.0.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-zip-archive": "^9.0.2",
    "toastify-react-native": "^7.2.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "baseline-browser-mapping": "^2.9.16",
    "eslint": "^8.17.0",
    "eslint-import-resolver-typescript": "2.7.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "^54.0.2",
    "knip": "^6.31.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "19.1.0",
    "steiger": "^0.6.0",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run lint-fix",
      "npm run format"
    ]
  },
  "overrides": {
    "react-native-safe-area-context": "5.6.1"
  },
  "private": true
}
